# Paper defaults sourced by the public shell wrappers. An existing environment
# variable takes precedence over the value below.

: "${DATA_FILE:=2023_2025_Iron_data.csv}"
: "${SEED:=2021}"
: "${SEQ_LEN:=96}"
: "${LABEL_LEN:=48}"
: "${PRED_LEN:=48}"
: "${CHANNELS:=4}"

: "${LLM_MODEL:=LLAMA}"
: "${LLM_MODEL_ID:=huggyllama/llama-7b}"
: "${LLM_DIM:=4096}"
: "${LLM_LAYERS:=32}"
: "${PROMPT_DOMAIN:=0}"
: "${D_MODEL:=32}"
: "${D_FF:=128}"

: "${MAGNITUDE_NUM_TOKENS:=1000}"
: "${MAGNITUDE_PROTOTYPE_MODE:=vocab_mapping}"
: "${MAGNITUDE_REPROGRAMMING_D_KEYS:=128}"

: "${EVENT_NUM_TOKENS:=1000}"
: "${EVENT_PROTOTYPE_MODE:=direct}"
: "${EVENT_REPROGRAMMING_D_KEYS:=32}"

export DATA_FILE SEED SEQ_LEN LABEL_LEN PRED_LEN CHANNELS
export LLM_MODEL LLM_MODEL_ID LLM_DIM LLM_LAYERS PROMPT_DOMAIN D_MODEL D_FF
export MAGNITUDE_NUM_TOKENS MAGNITUDE_PROTOTYPE_MODE MAGNITUDE_REPROGRAMMING_D_KEYS
export EVENT_NUM_TOKENS EVENT_PROTOTYPE_MODE EVENT_REPROGRAMMING_D_KEYS
